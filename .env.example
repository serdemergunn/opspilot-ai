# Copy to .env and set real values. Never commit .env.
# Services bind to 127.0.0.1 only. Anonymous access is acceptable ONLY for local use with synthetic data.
# Passwords must meet SQL Server complexity rules and must not contain ';' (they go into connection strings).

# --- Agent mode ---
# demo: deterministic, clearly labeled responses computed from the dataset (no API key needed)
# live: uses the configured LLM provider
OPSPILOT_MODE=demo

# --- Clock: pins "today" so relative ranges match the synthetic dataset. Empty = wall clock. ---
OPSPILOT_REFERENCE_TIME_UTC=2026-11-11T00:00:00Z
OPSPILOT_PLANT_TIMEZONE=UTC

# --- SQL Server ---
MSSQL_SA_PASSWORD=
OPSPILOT_DB_READER_PASSWORD=

# --- Internal tool endpoints (AI service -> API) ---
OPSPILOT_SERVICE_KEY=

# --- Live mode (Claude) ---
# Leave empty to stay in demo mode; live requests then fall back to demo and say so in their warnings.
# OPSPILOT_ALLOW_LIVE lets the AI Analyst's "Live (Claude)" switch use the model (each request is billed).
ANTHROPIC_API_KEY=
OPSPILOT_ALLOW_LIVE=false
